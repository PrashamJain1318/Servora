# ==============================================================================
# SERVORA — Environment Variables Template (Development)
# ==============================================================================
# IMPORTANT: This file is a template. Copy to .env.local for local overrides.
# NEVER commit production credentials or API keys to version control.
# ==============================================================================

# Application Runtime & Ports
NODE_ENV=development
PORT=4000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Datastores (Phase 2+)
# MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017/servora_dev
# Upstash Redis connection URL
REDIS_URL=redis://localhost:6379

# Authentication (Clerk - Phase 3+)
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_PUBLISHABLE_KEY=pk_test_placeholder
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_WEBHOOK_SECRET=whsec_placeholder

# AI Providers & Model Routing (Phase 11+)
OPENAI_API_KEY=sk-proj-placeholder
GEMINI_API_KEY=placeholder
AI_DEFAULT_MODEL=GPT-5.6 Luna
AI_BALANCED_MODEL=GPT-5.6 Terra
AI_COMPLEX_MODEL=GPT-5.6 Sol

# Email & Notifications (Resend - Phase 6+)
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL=notifications@servora.app

# Analytics & Observability (PostHog & Sentry)
NEXT_PUBLIC_POSTHOG_KEY=phc_placeholder
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=https://placeholder@sentry.io/placeholder

# SaaS Billing & Payments (Stripe & Razorpay)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder

# Asset Storage (Cloudinary)
CLOUDINARY_URL=cloudinary://placeholder
