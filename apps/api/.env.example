# ==============================================================================
# SERVORA API — Environment Variables Template
# ==============================================================================
NODE_ENV=development
PORT=4000

# MongoDB Atlas or Local Connection String
# e.g., mongodb+srv://<username>:<password>@<cluster>.mongodb.net/servora?retryWrites=true&w=majority
# or local: mongodb://localhost:27017/servora_dev
MONGODB_URI=mongodb://localhost:27017/servora_dev

# Clerk Authentication & Webhooks (Phase 3+)
CLERK_SECRET_KEY=sk_test_placeholder
CLERK_WEBHOOK_SECRET=whsec_placeholder
CLERK_PUBLISHABLE_KEY=pk_test_placeholder

